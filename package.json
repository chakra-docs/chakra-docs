{
  "name": "chakra-docs-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Ryan Hefner",
    "email": "hi@ryanhefner.com",
    "url": "https://www.ryanhefner.com"
  },
  "contributors": [
    {
      "name": "Commune Software",
      "url": "https://commune.software"
    }
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test --coverage",
    "test:release": "nx run chakra-docs-workspace:release-validation",
    "types:performance:check": "npm exec nx -- run @chakra-docs/chakra:build && node scripts/check-chakra-theme-types.mjs",
    "typecheck": "nx run-many -t typecheck",
    "release:smoke": "node scripts/release-smoke.mjs",
    "yalc:publish": "nx yalc-publish"
  },
  "private": true,
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.2.10",
    "@nx/cypress": "22.7.8",
    "@nx/eslint": "22.7.8",
    "@nx/eslint-plugin": "22.7.8",
    "@nx/js": "22.7.8",
    "@nx/next": "22.7.8",
    "@nx/vite": "22.7.8",
    "@nx/vitest": "22.7.8",
    "@nx/web": "22.7.8",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "cypress": "^15.8.0",
    "eslint": "^9.39.4",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.8",
    "prettier": "^3.9.5",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "6.9.0",
    "vite": "^8.1.4",
    "vitest": "4.1.10",
    "yalc": "^1.0.0-pre.53"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "release-validation": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test scripts/release-workflow.spec.mjs"
        }
      },
      "yalc-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/yalc-publish.mjs"
        },
        "configurations": {
          "skip-build": {
            "command": "node scripts/yalc-publish.mjs --skip-build"
          },
          "no-push": {
            "command": "node scripts/yalc-publish.mjs --no-push"
          },
          "verify": {
            "command": "node scripts/yalc-publish.mjs --skip-build --no-push"
          }
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "@xhmikosr/decompress": "^11.1.3",
    "axios": "^1.18.1",
    "brace-expansion": "^5.0.9",
    "minimatch@3": {
      "brace-expansion": "^2.0.2"
    },
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.24",
    "qs": "^6.15.3",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "uuid": "^11.1.1"
  },
  "packageManager": "npm@11.13.0"
}
