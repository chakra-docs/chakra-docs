{
  "name": "chakra-docs-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Ryan Hefner",
    "email": "hi@ryanhefner.com",
    "url": "https://www.ryanhefner.com"
  },
  "contributors": [
    {
      "name": "Commune Software",
      "url": "https://commune.software"
    }
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test --coverage",
    "test:release": "nx run chakra-docs-workspace:release-validation",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "types:performance:check": "nx run @chakra-docs/chakra:build && node scripts/check-chakra-theme-types.mjs",
    "search:performance:check": "nx run @chakra-docs/search:build && node scripts/check-search-performance.mjs",
    "typecheck": "nx run-many -t typecheck",
    "release:smoke": "node scripts/release-smoke.mjs",
    "yalc:publish": "nx yalc-publish"
  },
  "private": true,
  "devDependencies": {
    "@chakra-docs/astro": "workspace:*",
    "@chakra-docs/chakra": "workspace:*",
    "@chakra-docs/cli": "workspace:*",
    "@chakra-docs/core": "workspace:*",
    "@chakra-docs/feed": "workspace:*",
    "@chakra-docs/next": "workspace:*",
    "@chakra-docs/react-router": "workspace:*",
    "@chakra-docs/search": "workspace:*",
    "@chakra-docs/search-pagefind": "workspace:*",
    "@chakra-docs/shiki": "workspace:*",
    "@chakra-docs/source-filesystem": "workspace:*",
    "@chakra-docs/source-git": "workspace:*",
    "@chakra-ui/react": "3.36.0",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.3.8",
    "@nx/cypress": "22.7.8",
    "@nx/eslint": "22.7.8",
    "@nx/eslint-plugin": "22.7.8",
    "@nx/js": "22.7.8",
    "@nx/next": "22.7.8",
    "@nx/vite": "22.7.8",
    "@nx/vitest": "22.7.8",
    "@nx/web": "22.7.8",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.43",
    "@swc/helpers": "0.5.23",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/lib-dom": "npm:@types/web@0.0.356",
    "@vitest/coverage-v8": "4.1.11",
    "astro": "7.3.2",
    "cypress": "^15.8.0",
    "eslint": "^9.39.4",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "^29.1.1",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.8",
    "prettier": "^3.9.5",
    "react-router": "8.3.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "6.9.0",
    "vite": "^8.1.4",
    "vitest": "4.1.11",
    "yaml": "^2.9.0",
    "yalc": "^1.0.0-pre.53"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      },
      "release-validation": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test scripts/release-workflow.spec.mjs scripts/verify-published-version.spec.mjs scripts/audit-dependencies.spec.mjs"
        }
      },
      "yalc-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/yalc-publish.mjs"
        },
        "configurations": {
          "skip-build": {
            "command": "node scripts/yalc-publish.mjs --skip-build"
          },
          "no-push": {
            "command": "node scripts/yalc-publish.mjs --no-push"
          },
          "verify": {
            "command": "node scripts/yalc-publish.mjs --skip-build --no-push"
          }
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
