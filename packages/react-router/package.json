{
  "name": "@chakra-docs/react-router",
  "version": "0.0.0",
  "description": "React Router route helpers for Chakra Docs manifests.",
  "keywords": [
    "chakra-ui",
    "documentation",
    "docs",
    "react-router",
    "remix",
    "react",
    "routes"
  ],
  "license": "MIT",
  "author": "Ryan Hefner <hi@ryanhefner.com> (https://www.ryanhefner.com)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ryanhefner"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/ryanhefner"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ryanhefner"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "prepack": "npm exec nx -- run @chakra-docs/react-router:build --skipNxCache --outputStyle=static"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@chakra-docs/core": "0.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-router": ">=7 <9"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanhefner/chakra-docs.git",
    "directory": "packages/react-router"
  },
  "bugs": {
    "url": "https://github.com/ryanhefner/chakra-docs/issues"
  },
  "homepage": "https://github.com/ryanhefner/chakra-docs#readme",
  "nx": {
    "tags": [
      "layer:adapter",
      "scope:react-router"
    ]
  }
}
