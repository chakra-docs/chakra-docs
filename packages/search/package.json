{
  "name": "@chakra-docs/search",
  "version": "0.2.0",
  "description": "Server-side search engine, Fetch handler, and HTTP client for Chakra Docs.",
  "keywords": [
    "chakra-ui",
    "documentation",
    "docs",
    "search",
    "nextjs",
    "nest",
    "server-search",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Ryan Hefner",
    "email": "hi@ryanhefner.com",
    "url": "https://www.ryanhefner.com"
  },
  "contributors": [
    {
      "name": "Commune Software",
      "url": "https://commune.software"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ryanhefner"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/ryanhefner"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ryanhefner"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "prepack": "npm exec nx -- run @chakra-docs/search:build --skipNxCache --outputStyle=static"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./minisearch": {
      "types": "./dist/minisearch.d.ts",
      "import": "./dist/minisearch.js",
      "default": "./dist/minisearch.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "@chakra-docs/search",
    "tags": [
      "layer:core",
      "scope:search"
    ]
  },
  "dependencies": {
    "@chakra-docs/core": "0.2.0",
    "minisearch": "^7.2.0",
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chakra-docs/chakra-docs.git",
    "directory": "packages/search"
  },
  "bugs": {
    "url": "https://github.com/chakra-docs/chakra-docs/issues"
  },
  "homepage": "https://github.com/chakra-docs/chakra-docs/tree/main/packages/search#readme"
}
