{
  "name": "@chakra-docs/core",
  "version": "0.0.0",
  "description": "Framework-agnostic Markdown and MDX document models and manifest utilities for documentation sites.",
  "keywords": [
    "chakra-ui",
    "documentation",
    "documentation-site",
    "docs",
    "manifest",
    "mdx",
    "markdown",
    "content",
    "document-model",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Ryan Hefner",
    "email": "hi@ryanhefner.com",
    "url": "https://www.ryanhefner.com"
  },
  "contributors": [
    {
      "name": "Commune Software",
      "url": "https://commune.software"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ryanhefner"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/ryanhefner"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ryanhefner"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "prepack": "npm exec nx -- run @chakra-docs/core:build --skipNxCache --outputStyle=static"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chakra-docs/chakra-docs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chakra-docs/chakra-docs/issues"
  },
  "homepage": "https://github.com/chakra-docs/chakra-docs/tree/main/packages/core#readme",
  "nx": {
    "tags": [
      "layer:core",
      "scope:core"
    ]
  }
}
