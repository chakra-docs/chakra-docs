{
  "name": "@chakra-docs/next",
  "version": "0.0.0",
  "description": "Next.js static route helpers for Chakra Docs manifests.",
  "keywords": [
    "chakra-ui",
    "documentation",
    "docs",
    "nextjs",
    "next",
    "react",
    "app-router",
    "pages-router"
  ],
  "license": "MIT",
  "author": "Ryan Hefner <hi@ryanhefner.com> (https://www.ryanhefner.com)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ryanhefner"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/ryanhefner"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ryanhefner"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "prepack": "npm exec nx -- run @chakra-docs/next:build --skipNxCache --outputStyle=static"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js",
      "default": "./dist/link.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js",
      "default": "./dist/pages.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@chakra-docs/core": "0.0.0",
    "@chakra-docs/search": "0.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "next": ">=15.5.18 <16 || >=16.2.6 <17",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanhefner/chakra-docs.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/ryanhefner/chakra-docs/issues"
  },
  "homepage": "https://github.com/ryanhefner/chakra-docs#readme",
  "nx": {
    "tags": [
      "layer:adapter",
      "scope:next"
    ]
  }
}
