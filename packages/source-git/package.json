{
  "name": "@chakra-docs/source-git",
  "version": "0.0.0",
  "description": "Remote Git content source for Chakra Docs.",
  "keywords": [
    "chakra-ui",
    "documentation",
    "docs",
    "git",
    "content-source",
    "remote-content"
  ],
  "license": "MIT",
  "author": "Ryan Hefner <hi@ryanhefner.com> (https://www.ryanhefner.com)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ryanhefner"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/ryanhefner"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ryanhefner"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "prepack": "npm exec nx -- run @chakra-docs/source-git:build --skipNxCache --outputStyle=static"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@chakra-docs/core": "0.0.0",
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chakra-docs/chakra-docs.git",
    "directory": "packages/source-git"
  },
  "bugs": {
    "url": "https://github.com/chakra-docs/chakra-docs/issues"
  },
  "homepage": "https://github.com/chakra-docs/chakra-docs#readme",
  "nx": {
    "tags": [
      "layer:source",
      "scope:source-git"
    ]
  }
}
