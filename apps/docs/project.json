{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "tags": ["layer:app", "scope:docs"],
  "// targets": "to see all targets run: nx show project docs --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/docs",
        "command": "next build --webpack",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["next"]
        },
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/docs/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/docs/.next/!(cache)"
      ],
      "syncGenerators": ["@nx/js:typescript-sync"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/docs",
        "command": "next dev --webpack",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "continuous": true,
      "syncGenerators": ["@nx/js:typescript-sync"]
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "cwd": "apps/docs",
        "command": "next start",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "cwd": "apps/docs",
        "command": "next start",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/docs",
        "commands": [
          "tsc --noEmit -p tsconfig.json",
          "tsc --noEmit -p cypress/tsconfig.json"
        ],
        "parallel": false
      },
      "inputs": ["production", "^production"]
    }
  }
}
