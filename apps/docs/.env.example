# Canonical public origin used for metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://docs.example.com

# Make production builds fail instead of silently omitting canonical URLs.
CHAKRA_DOCS_REQUIRE_SITE_URL=true

# Optional React Fathom analytics; leave the ID blank to disable tracking.
NEXT_PUBLIC_FATHOM_SITE_ID=
NEXT_PUBLIC_FATHOM_CUSTOM_DOMAIN=cdn.usefathom.com

# Shared OSS Suisse font kit (default). Allow the local and production domains
# in Fontstack. Set an empty value to use system fonts instead.
NEXT_PUBLIC_FONTSTACK_KIT_URL=https://kits.fontstack.com/kit/o0v0t0oi.css
